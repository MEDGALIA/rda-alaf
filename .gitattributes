# Normalize all text files to LF in the repository and on checkout,
# regardless of each contributor's local core.autocrlf setting.
* text=auto eol=lf

# Binary files must never go through line-ending normalization —
# doing so would corrupt them.
*.xlsx binary
*.xls binary
*.docx binary
*.doc binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
